# Copy to .env.local and fill in.

# Contact form delivery via Resend (https://resend.com). Without a key the form still
# works: submissions are logged to the server console and the visitor is redirected to /vielen-dank/.
RESEND_API_KEY=
# Recipient of contact requests (defaults to kontakt@nrw-haushaltsaufloesung.de)
CONTACT_TO=kontakt@nrw-haushaltsaufloesung.de
# Verified sender in Resend (domain nrw-haushaltsaufloesung.de must be verified there)
CONTACT_FROM="NRW-Haushaltsauflösung <anfrage@nrw-haushaltsaufloesung.de>"

# Google Tag Manager container from the old WordPress site (GTM-TV72H2Z).
# Leave empty to ship zero third-party scripts. If you enable it, add a consent banner first.
NEXT_PUBLIC_GTM_ID=
